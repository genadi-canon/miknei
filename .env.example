DATABASE_URL="postgresql://miknei:miknei@localhost:5432/miknei"
# Direct connection for migrations (on Neon/Vercel this is the non-pooled URL)
DATABASE_URL_UNPOOLED="postgresql://miknei:miknei@localhost:5432/miknei"
# Public base URL used in payment links and provider redirects
APP_URL="http://localhost:3000"
# Protects /api/cron/auto-capture. Call it every few minutes with: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="change-me"
# mock | rapyd (only mock is implemented until a processor contract is signed)
PAYMENT_PROVIDER="mock"
# mock | (real SMS gateway later). The mock prints codes to the server log and shows them on screen in dev.
SMS_PROVIDER="mock"
# 1 = public demo: fake processor and SMS allowed in production, codes shown on screen, demo banner
DEMO_MODE="0"
